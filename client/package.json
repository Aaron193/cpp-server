{
    "name": "client",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "protocol:generate": "node ../protocol/generate.mjs",
        "protocol:check": "node ../protocol/generate.mjs --check",
        "map:compile": "node --import tsx tools/map-compiler/cli.ts maps/graybox-arena.gltf public/maps/graybox-arena",
        "map:check": "node --import tsx tools/map-compiler/cli.ts --check maps/graybox-arena.gltf public/maps/graybox-arena",
        "smoke:jolt": "node --import tsx tools/jolt-smoke.ts",
        "smoke:performance": "node --import tsx tools/performance-smoke.ts",
        "bots:syntax": "node --import tsx --check bots_test/bots.js && node --import tsx --check bots_test/spambots.js && node --import tsx --check bots_test/two-client-harness.js",
        "harness:phase4": "node --import tsx bots_test/two-client-harness.js",
        "harness:phase5": "node --import tsx bots_test/two-client-harness.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@types/node": "^26.0.0",
        "@types/ws": "8.18.1",
        "prettier": "^3.6.2",
        "tsx": "^4.20.0",
        "typescript": "^5.6.3",
        "vite": "8.2.2",
        "vitest": "4.1.11",
        "ws": "8.21.3"
    },
    "dependencies": {
        "@babylonjs/core": "9.22.1",
        "@babylonjs/loaders": "9.22.1",
        "jolt-physics": "1.1.0"
    }
}
