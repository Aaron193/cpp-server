# Copy to .env and replace every change-me value before deployment. Validate
# with: ./scripts/validate-deployment.sh --env-file .env

# DATABASE CONFIGURATION
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-database-password
POSTGRES_DB=game_db
DATABASE_URL=postgresql://postgres:change-me-strong-database-password@db:5432/game_db

# ========== WEB SERVER CONFIG ==========
# Public browser origin at the TLS terminator; no trailing slash.
CLIENT_ORIGIN=https://game.example.com

# JWT Authentication
JWT_SECRET=change-me-at-least-32-random-bytes
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Server Authentication (shared secret between game servers and web server)
SERVER_SHARED_SECRET=change-me-independent-random-shared-secret

# ========== C++ GAME SERVER CONFIG ==========
SERVER_ID=game-us-central-1

# Registry metadata only. Clients use SERVER_WEBSOCKET_URL exactly as supplied.
SERVER_HOST=game.example.com

SERVER_REGION=us-central
MAX_PLAYERS=12
SERVER_MODE=ffa
SERVER_BUILD_ID=release-2026-08-24.1

# Compatibility metadata is fixed by this deployment: protocol v3 and the
# graybox-arena package. Compose supplies both to the server container.
# This must be a complete externally reachable URL and must use wss:// in prod.
SERVER_WEBSOCKET_URL=wss://game.example.com/game/

# Public host port for the HTTP origin behind your TLS terminator.
HTTP_PORT=8080

# Optional immutable image names/tags and vcpkg registry override.
# WEB_IMAGE=registry.example.com/game/web:release-2026-08-24.1
# GAME_SERVER_IMAGE=registry.example.com/game/server:release-2026-08-24.1
# CLIENT_IMAGE=registry.example.com/game/client:release-2026-08-24.1
# VCPKG_COMMIT=af752f21c9d79ba3df9cb0250ce2233933f58486
