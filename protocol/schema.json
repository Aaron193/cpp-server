{
  "name": "ArenaProtocol",
  "version": 6,
  "limits": {
    "maxEnvelopeBytes": 61443,
    "maxPayloadBytes": 61440,
    "maxStringBytes": 16384,
    "maxBuildIdBytes": 64,
    "maxMapIdBytes": 64,
    "maxHashBytes": 128,
    "maxAccessTokenBytes": 512,
    "maxRejectDetailBytes": 256,
    "maxChatBytes": 512,
    "maxConfigurationBytes": 16384,
    "maxInputCommands": 64,
    "maxSnapshotEntities": 512,
    "maxSnapshotCreated": 512,
    "maxSnapshotUpdated": 512,
    "maxSnapshotRemoved": 512
  },
  "enums": {
    "RejectReason": { "underlying": "u8", "values": { "VersionMismatch": 1, "BuildMismatch": 2, "MapMismatch": 3, "ServerFull": 4, "Unauthorized": 5, "InvalidHello": 6, "InternalError": 7 } },
    "EntityKind": { "underlying": "u8", "values": { "Player": 1, "Spectator": 2, "Prop": 3 } },
    "MatchPhase": { "underlying": "u8", "values": { "Waiting": 1, "Active": 2, "Intermission": 3, "Ended": 4 } },
    "Weapon": { "underlying": "u8", "values": { "None": 0, "Rifle": 1, "Shotgun": 2 } },
    "RemoveReason": { "underlying": "u8", "values": { "Disconnected": 1, "Destroyed": 2, "OutOfScope": 3 } },
    "ImpactMaterial": { "underlying": "u8", "values": { "World": 1, "Player": 2 } },
    "RoundTransitionKind": { "underlying": "u8", "values": { "Started": 1, "Ended": 2, "Intermission": 3, "Reset": 4 } },
    "ChatChannel": { "underlying": "u8", "values": { "Global": 1, "System": 2 } }
    ,"ActionKind": { "underlying": "u8", "values": { "Fire": 1, "Reload": 2 } }
    ,"ActionRejectReason": { "underlying": "u8", "values": { "None": 0, "Cadence": 1, "NoAmmo": 2, "Dead": 3, "MatchInactive": 4, "WeaponMismatch": 5, "AlreadyReloading": 6, "MagazineFull": 7, "NoReserve": 8, "Duplicate": 9, "Invalid": 10 } }
  },
  "types": {
    "Vec3": [
      { "name": "x", "type": "f32" }, { "name": "y", "type": "f32" }, { "name": "z", "type": "f32" }
    ],
    "MapDescriptor": [
      { "name": "mapId", "type": "string", "max": "maxMapIdBytes" },
      { "name": "formatVersion", "type": "u16" },
      { "name": "contentHash", "type": "string", "max": "maxHashBytes" }
    ],
    "MatchState": [
      { "name": "phase", "type": { "enum": "MatchPhase" } },
      { "name": "roundNumber", "type": "u16" },
      { "name": "phaseEndsAtTick", "type": "u32" }
    ],
    "WeaponState": [
      { "name": "selected", "type": { "enum": "Weapon" } },
      { "name": "magazineAmmo", "type": "u16" },
      { "name": "reserveAmmo", "type": "u16" },
      { "name": "stateFlags", "type": "u8" }
    ],
    "InputCommand": [
      { "name": "sequence", "type": "u32" },
      { "name": "clientTick", "type": "u32", "description": "Server tick domain learned from Snapshot.serverTick; early or out-of-domain values are clamped by the server." },
      { "name": "moveX", "type": "f32" }, { "name": "moveY", "type": "f32" },
      { "name": "buttonFlags", "type": "u16" },
      { "name": "fireActionId", "type": "u32", "description": "Zero when this command has no fire edge; otherwise a generated action correlation id independent of sequence." },
      { "name": "reloadActionId", "type": "u32", "description": "Zero when this command has no reload edge; otherwise a generated action correlation id independent of sequence." },
      { "name": "yaw", "type": "f32" }, { "name": "pitch", "type": "f32" },
      { "name": "selectedWeapon", "type": { "enum": "Weapon" } }
    ],
    "EntityHandle": [
      { "name": "slot", "type": "u32", "description": "Stable entity slot/id. Pair with generation; never key a view by slot alone." },
      { "name": "generation", "type": "u16", "description": "Increments when a slot is reused." }
    ],
    "PublicEntityState": [
      { "name": "handle", "type": { "ref": "EntityHandle" } },
      { "name": "kind", "type": { "enum": "EntityKind" } },
      { "name": "position", "type": { "ref": "Vec3" } },
      { "name": "velocity", "type": { "ref": "Vec3" } },
      { "name": "bodyYaw", "type": "f32" }, { "name": "aimPitch", "type": "f32" },
      { "name": "grounded", "type": "bool" }, { "name": "stateFlags", "type": "u16" },
      { "name": "equippedWeapon", "type": { "enum": "Weapon" } }
    ],
    "CreatedEntity": [
      { "name": "state", "type": { "ref": "PublicEntityState" } }
    ],
    "UpdatedEntity": [
      { "name": "handle", "type": { "ref": "EntityHandle" } },
      { "name": "changeMask", "type": "u16", "description": "Bits: position=1 velocity=2 bodyYaw=4 aimPitch=8 grounded=16 stateFlags=32 equippedWeapon=64. Presence must exactly match bits." },
      { "name": "position", "type": { "optional": { "ref": "Vec3" } } },
      { "name": "velocity", "type": { "optional": { "ref": "Vec3" } } },
      { "name": "bodyYaw", "type": { "optional": "f32" } },
      { "name": "aimPitch", "type": { "optional": "f32" } },
      { "name": "grounded", "type": { "optional": "bool" } },
      { "name": "stateFlags", "type": { "optional": "u16" } },
      { "name": "equippedWeapon", "type": { "optional": { "enum": "Weapon" } } }
    ],
    "RemovedEntity": [
      { "name": "handle", "type": { "ref": "EntityHandle" } },
      { "name": "reason", "type": { "enum": "RemoveReason" } }
    ],
    "LocalAuthoritativeState": [
      { "name": "handle", "type": { "ref": "EntityHandle" } },
      { "name": "position", "type": { "ref": "Vec3" } },
      { "name": "velocity", "type": { "ref": "Vec3" } },
      { "name": "bodyYaw", "type": "f32" }, { "name": "aimPitch", "type": "f32" },
      { "name": "grounded", "type": "bool" }, { "name": "stateFlags", "type": "u16" },
      { "name": "health", "type": "u16" },
      { "name": "weaponState", "type": { "ref": "WeaponState" } }
    ],
    "EntityRecord": [
      { "name": "entityId", "type": "u32" },
      { "name": "kind", "type": { "enum": "EntityKind" } },
      { "name": "position", "type": { "ref": "Vec3" } },
      { "name": "velocity", "type": { "ref": "Vec3" } },
      { "name": "bodyYaw", "type": "f32" }, { "name": "aimPitch", "type": "f32" },
      { "name": "grounded", "type": "bool" }, { "name": "stateFlags", "type": "u16" },
      { "name": "equippedWeapon", "type": { "enum": "Weapon" } }
    ]
  },
  "messages": {
    "Hello": { "id": 1, "fields": [
      { "name": "protocolVersion", "type": "u16" },
      { "name": "clientBuildId", "type": "string", "max": "maxBuildIdBytes" },
      { "name": "supportedMapFormat", "type": "u16" },
      { "name": "accessToken", "type": { "optional": "string" }, "max": "maxAccessTokenBytes" }
    ] },
    "Welcome": { "id": 2, "fields": [
      { "name": "protocolVersion", "type": "u16" },
      { "name": "serverBuildId", "type": "string", "max": "maxBuildIdBytes" },
      { "name": "playerId", "type": "u32", "description": "Raw EnTT value retained for combat/score event correlation in protocol v6; entity view identity uses playerHandle." },
      { "name": "playerHandle", "type": { "ref": "EntityHandle" } },
      { "name": "tickRate", "type": "u16" }, { "name": "snapshotRate", "type": "u16" },
      { "name": "map", "type": { "ref": "MapDescriptor" } },
      { "name": "configurationHash", "type": "string", "max": "maxHashBytes" }
    ] },
    "Reject": { "id": 3, "fields": [
      { "name": "serverBuildId", "type": "string", "max": "maxBuildIdBytes" },
      { "name": "reason", "type": { "enum": "RejectReason" } },
      { "name": "detail", "type": "string", "max": "maxRejectDetailBytes" },
      { "name": "expectedProtocolVersion", "type": "u16" }, { "name": "expectedMapFormat", "type": "u16" }
    ] },
    "InputBatch": { "id": 4, "fields": [
      { "name": "commands", "type": { "array": { "ref": "InputCommand" } }, "max": "maxInputCommands", "min": 1 }
    ] },
    "Snapshot": { "id": 5, "fields": [
      { "name": "serverTick", "type": "u32" }, { "name": "lastProcessedInputSequence", "type": "u32" },
      { "name": "match", "type": { "ref": "MatchState" } },
      { "name": "entities", "type": { "array": { "ref": "EntityRecord" } }, "max": "maxSnapshotEntities" }
    ] },
    "Spawn": { "id": 6, "fields": [{ "name": "serverTick", "type": "u32" }, { "name": "entity", "type": { "ref": "PublicEntityState" } }] },
    "Remove": { "id": 7, "fields": [{ "name": "serverTick", "type": "u32" }, { "name": "handle", "type": { "ref": "EntityHandle" } }, { "name": "reason", "type": { "enum": "RemoveReason" } }] },
    "ShotConfirmed": { "id": 8, "fields": [{ "name": "serverTick", "type": "u32" }, { "name": "shooterId", "type": "u32" }, { "name": "inputSequence", "type": "u32" }, { "name": "actionId", "type": "u32" }, { "name": "shotId", "type": "u32" }, { "name": "weapon", "type": { "enum": "Weapon" } }] },
    "Impact": { "id": 9, "fields": [{ "name": "serverTick", "type": "u32" }, { "name": "shotId", "type": "u32" }, { "name": "position", "type": { "ref": "Vec3" } }, { "name": "normal", "type": { "ref": "Vec3" } }, { "name": "material", "type": { "enum": "ImpactMaterial" } }] },
    "Damage": { "id": 10, "fields": [{ "name": "serverTick", "type": "u32" }, { "name": "sourceId", "type": { "optional": "u32" } }, { "name": "targetId", "type": "u32" }, { "name": "amount", "type": "u16" }, { "name": "remainingHealth", "type": "u16" }] },
    "Death": { "id": 11, "fields": [{ "name": "serverTick", "type": "u32" }, { "name": "victimId", "type": "u32" }, { "name": "killerId", "type": { "optional": "u32" } }, { "name": "weapon", "type": { "enum": "Weapon" } }] },
    "Respawn": { "id": 12, "fields": [{ "name": "serverTick", "type": "u32" }, { "name": "playerId", "type": "u32" }, { "name": "position", "type": { "ref": "Vec3" } }, { "name": "bodyYaw", "type": "f32" }] },
    "ScoreChange": { "id": 13, "fields": [{ "name": "serverTick", "type": "u32" }, { "name": "playerId", "type": "u32" }, { "name": "score", "type": "i32" }, { "name": "delta", "type": "i16" }, { "name": "kills", "type": "u32" }, { "name": "deaths", "type": "u32" }] },
    "RoundTransition": { "id": 14, "fields": [{ "name": "serverTick", "type": "u32" }, { "name": "transition", "type": { "enum": "RoundTransitionKind" } }, { "name": "match", "type": { "ref": "MatchState" } }] },
    "Chat": { "id": 15, "fields": [{ "name": "senderId", "type": { "optional": "u32" } }, { "name": "channel", "type": { "enum": "ChatChannel" } }, { "name": "text", "type": "string", "max": "maxChatBytes" }] },
    "Configuration": { "id": 16, "fields": [
      { "name": "protocolVersion", "type": "u16" }, { "name": "serverBuildId", "type": "string", "max": "maxBuildIdBytes" },
      { "name": "map", "type": { "ref": "MapDescriptor" } }, { "name": "configurationHash", "type": "string", "max": "maxHashBytes" },
      { "name": "configurationJson", "type": "string", "max": "maxConfigurationBytes" }
    ] },
    "Ping": { "id": 17, "fields": [
      { "name": "pingId", "type": "u32", "description": "Client-generated correlation ID. Values may wrap modulo 2^32." }
    ] },
    "Pong": { "id": 18, "fields": [
      { "name": "pingId", "type": "u32", "description": "Exact echo of Ping.pingId." },
      { "name": "serverTick", "type": "u32", "description": "Authoritative 60 Hz simulation tick at pong creation; wraps modulo 2^32." },
      { "name": "serverMonotonicMs", "type": "u32", "description": "Low 32 bits of steady-clock milliseconds at pong creation. It is not wall-clock or Unix time and wraps modulo 2^32." }
    ] },
    "SnapshotDelta": { "id": 19, "fields": [
      { "name": "snapshotSequence", "type": "u32", "description": "Monotonic per-connection sequence." },
      { "name": "baselineSequence", "type": "u32", "description": "Immediately previous applied ordered SnapshotDelta sequence, or zero on reset." },
      { "name": "baselineRevision", "type": "u32", "description": "Changes whenever the server resets the per-client baseline." },
      { "name": "baselineReset", "type": "bool", "description": "Clears all decoder state before applying created records." },
      { "name": "serverTick", "type": "u32" },
      { "name": "lastProcessedInputSequence", "type": "u32" },
      { "name": "matchRevision", "type": "u32" },
      { "name": "match", "type": { "optional": { "ref": "MatchState" } } },
      { "name": "local", "type": { "ref": "LocalAuthoritativeState" } },
      { "name": "created", "type": { "array": { "ref": "CreatedEntity" } }, "max": "maxSnapshotCreated" },
      { "name": "updated", "type": { "array": { "ref": "UpdatedEntity" } }, "max": "maxSnapshotUpdated" },
      { "name": "removed", "type": { "array": { "ref": "RemovedEntity" } }, "max": "maxSnapshotRemoved" }
    ] },
    "ActionResult": { "id": 20, "fields": [
      { "name": "serverTick", "type": "u32" },
      { "name": "actionId", "type": "u32" },
      { "name": "kind", "type": { "enum": "ActionKind" } },
      { "name": "accepted", "type": "bool" },
      { "name": "reason", "type": { "enum": "ActionRejectReason" } },
      { "name": "weapon", "type": { "enum": "Weapon" } },
      { "name": "authoritativeMagazineAmmo", "type": "u16" },
      { "name": "authoritativeReserveAmmo", "type": "u16" }
    ] }
  }
}
