# Dockerfile for Client (Static Build)

FROM node:20.19.5-alpine AS builder

WORKDIR /app

# Accept build arguments for environment configuration
ARG CLIENT_API_BASE=/api
ARG CLIENT_BUILD_ID=dev

# Vite exposes only explicitly prefixed client build variables.
ENV VITE_CLIENT_API_BASE=${CLIENT_API_BASE}
ENV VITE_CLIENT_BUILD_ID=${CLIENT_BUILD_ID}

# Copy package files
COPY client/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY client/ ./

# Build production bundle
RUN npm run build

# =============================================================================
# Production stage with nginx
# =============================================================================
# Stock nginx includes gzip and the standard application/wasm MIME table. It
# does not include Brotli, so the production configuration deliberately does
# not advertise or enable Brotli.
FROM nginx:1.27.5-alpine AS production

# Copy custom nginx configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy built static files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Create non-root user for nginx
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx && \
    chown -R nginx:nginx /etc/nginx/conf.d

# Use non-root user
USER nginx

# The master process runs unprivileged, so nginx binds a non-privileged port.
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:8080/health || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
